# Copy to .env and fill in. .env is gitignored, never commit your key.

# Your model provider key (OpenAI shown; adapt for your provider).
OPENAI_API_KEY=sk-...

# Model + bounds. These ARE your M5 deliverable, tune and justify them.
CORTEX_MODEL=gpt-4o-mini      # use a cheap, fast model; a full run is ~cents
CORTEX_MAX_ITERATIONS=6       # loop cap: stop + escalate instead of spinning
CORTEX_MAX_REVISIONS=2        # critic<->drafter cap: stop the bounce-forever bomb
CORTEX_COST_CAP_USD=0.10      # hard spend cap per run, enforced outside the model
CORTEX_DAILY_COST_CAP_USD=1.00  # hard spend cap across all of today's runs
CORTEX_TIMEOUT_S=60          # wall-clock cap per run: stop + escalate a hung run
CORTEX_MAX_QUEUE_ITEMS=5      # commitment cap: max backlog stories queued per run
CORTEX_MAX_TOOL_FAILURES=3    # stuck cap: consecutive tool errors before Cortex gives up

# Rough $ per 1M tokens for your chosen model (for the in-code cost estimate).
CORTEX_PRICE_IN_PER_M=0.15
CORTEX_PRICE_OUT_PER_M=0.60

# The critic (independent validator) runs on its own model + price (M3 decision).
CORTEX_CRITIC_MODEL=gpt-4.1
CORTEX_CRITIC_PRICE_IN_PER_M=2.00
CORTEX_CRITIC_PRICE_OUT_PER_M=8.00
